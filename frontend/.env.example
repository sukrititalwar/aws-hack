# Copy to .env.local (or set in Amplify > Environment variables)
VITE_API_URL=https://xxxxxxxx.execute-api.ap-south-1.amazonaws.com
VITE_CITY=delhi
# Experimental next-hour route-risk UI and API. Keep disabled until the backend is approved/enabled.
VITE_PREDICTIVE_ROUTE_ENABLED=false
# Amazon Location Service API key (Maps + Places). Leave empty to fall back to OSM tiles.
VITE_LOCATION_API_KEY=
VITE_LOCATION_REGION=ap-south-1
# WhatsApp reporting: Twilio sandbox number (digits only) and the sandbox "join <code>" phrase,
# or your AWS End User Messaging Social number (leave JOIN empty).
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_JOIN=

# Google Maps basemap (optional). Needs a Google Cloud API key with the "Maps JavaScript API" enabled.
# Restrict the key to your site's HTTP referrers. Without it (or if Google rejects it) the app uses
# the Amazon Location / OpenStreetMap map automatically.
VITE_GOOGLE_MAPS_API_KEY=

# Sign-in (Amazon Cognito): stack output UserPoolClientId. Leave empty to hide sign-in.
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=ap-south-1
# LOCAL DEVELOPMENT ONLY (any email works, token is "mock:<email>", only scripts/local_api.py accepts it).
# Never set this in Amplify.
# VITE_AUTH_MODE=mock
